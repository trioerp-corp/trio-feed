<Project Sdk="Microsoft.NET.Sdk">
  <!-- «TrioWindow.exe»: Trio in its own window (Edge WebView2), no browser bar. .NET Framework 4.8 = already in Windows 10/11.
       Build (Windows): dotnet build -c Release  → bin\Release\net48\ (TrioWindow.exe + the 3 WebView2 dlls). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>TrioWindow</AssemblyName>
    <RootNamespace>TrioWindow</RootNamespace>
    <ApplicationIcon>trio.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Version>1.0.0</Version>
    <Product>Trio</Product>
    <Company>Trio</Company>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web.Extensions" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <EmbeddedResource Include="trio.ico" LogicalName="trio.ico" />
  </ItemGroup>
</Project>
